<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package-visibility (API 30+, minSdk 31): the `launch` RPC targets arbitrary
         third-party packages via getLaunchIntentForPackage/ACTION_MAIN. Without this,
         a target outside the automatic-visibility exemptions can silently fail to
         resolve, indistinguishable from "app not installed." -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhonectlCompanion">

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service: hosts the loopback NDJSON server + ongoing "Stop phonectl"
             notification. FOREGROUND_SERVICE_SPECIAL_USE: a local automation IPC surface
             that has no better-fitting foreground-service type. -->
        <service
            android:name=".service.CompanionForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="phonectl local automation transport (loopback only)" />
        </service>

        <!-- AccessibilityService — flags per accessibility-companion SPEC §1. -->
        <service
            android:name=".service.CompanionAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- NotificationListenerService — surfaces active notifications + inline reply/dismiss
             over the same loopback transport (accessibility-companion SPEC §6). The
             BIND_NOTIFICATION_LISTENER_SERVICE permission + intent filter are required for the
             platform to bind it; the user must additionally grant access in Settings. -->
        <service
            android:name=".service.CompanionNotificationListenerService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Quick-Settings tile — flips the stopped flag (foreground-service SPEC §5). -->
        <service
            android:name=".service.StopTileService"
            android:exported="true"
            android:icon="@drawable/ic_stop_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Lifecycle seam (foreground-service SPEC §8): the Phase-5 daemon sends start/stop via
             `adb shell am broadcast` with the paired token as a string extra ("token"). Exported
             so `am broadcast` can reach it (shell UID cannot hold a signature permission), so the
             receiver itself verifies the paired companion token and ignores unauthenticated
             broadcasts (Finding 14). No daemon wiring. -->
        <receiver
            android:name=".service.LifecycleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.phonectl.companion.action.START_SERVICE" />
                <action android:name="com.phonectl.companion.action.STOP_SERVICE" />
                <action android:name="com.phonectl.companion.action.SET_TOKEN" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
